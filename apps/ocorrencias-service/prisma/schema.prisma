generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}
datasource db {
  provider = "postgresql"
  url      = env("OCC_DATABASE_URL")
}
model Central {
  id        String @id @default(uuid()) @db.Uuid
  codigo    String @unique
  nome      String
  ativo     Boolean @default(true)
  admins    Admin[]
  ocorrencias Ocorrencia[]
}
model Admin {
  id          String @id @default(uuid()) @db.Uuid
  centralId   String @db.Uuid
  nome        String
  email       String @unique
  senhaHash   String
  ativo       Boolean @default(true)
  papel       String @default("ADMIN")
  sessoes     Sessao[]
  central     Central @relation(fields:[centralId],references:[id])
}
model Ocorrencia {
  versao Int @default(0)
  id              String @id @default(uuid()) @db.Uuid
  centralId       String @db.Uuid
  clientRequestId String
  descricao String
  enderecoFormatado String @default("")
  bairro String?
  cep String?
  numero String?
  complemento String?
  referencia String?
  observacoes String?
  origemLocalizacao String
  precisaoLocalizacao String
  localConfirmado Boolean @default(false)
  eventos EventoOcorrencia[]
  tipo            String
  prioridade      Int
  latitude        Float
  longitude       Float
  status          String @default("RECEBIDA")
  viaturaId       String? @db.Uuid
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt
  central         Central @relation(fields:[centralId], references:[id])
  @@unique([centralId,clientRequestId])
  @@index([status,criadoEm])
}
model Outbox {
  id           String @id @default(uuid()) @db.Uuid
  tipo         String
  payload      Json
  criadoEm     DateTime @default(now())
  publicadoEm  DateTime?
  lockedUntil  DateTime?
  tentativas   Int @default(0)
  @@index([publicadoEm,lockedUntil])
}

model Sessao {
  tokens SessaoToken[]
  eventos EventoSessao[]
  id String @id @default(uuid()) @db.Uuid
  adminId String @db.Uuid
  tokenHash String @unique
  anteriorHash String?
  rotacionadoEm DateTime @default(now())
  expiraEm DateTime
  revogadoEm DateTime?
  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  @@index([adminId])
}

model EventoOcorrencia {
 id String @id @default(uuid()) @db.Uuid
 ocorrenciaId String @db.Uuid
 tipo String
 ocorridoEm DateTime @db.Timestamptz(3)
 registradoEm DateTime @default(now()) @db.Timestamptz(3)
 origemServico String
 eventIdOrigem String @unique
 adminId String? @db.Uuid
 centralId String? @db.Uuid
 descricao String
 metadados Json?
 ocorrencia Ocorrencia @relation(fields:[ocorrenciaId],references:[id])
 @@index([ocorrenciaId,ocorridoEm,id])
}

model SessaoToken {
 tokenHash String @id
 sessaoId String @db.Uuid
 usadoEm DateTime @default(now()) @db.Timestamptz(3)
 sessao Sessao @relation(fields:[sessaoId],references:[id],onDelete:Cascade)
}
model EventoSessao {
 id String @id @default(uuid()) @db.Uuid
 sessaoId String @db.Uuid
 tipo String
 ocorridoEm DateTime @default(now()) @db.Timestamptz(3)
 sessao Sessao @relation(fields:[sessaoId],references:[id],onDelete:Cascade)
}
