{
  "name": "@sdv/ocorrencias",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json && cp src/schema.graphql dist/schema.graphql && mkdir -p dist/generated && cp -R src/generated/client dist/generated/client",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@nestjs/apollo": "^12.2.2",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/graphql": "^12.2.2",
    "@nestjs/platform-express": "^10.4.15",
    "@apollo/server": "^4.12.2",
    "@apollo/subgraph": "^2.11.1",
    "@prisma/client": "6.19.0",
    "@sdv/shared": "0.1.0",
    "bcryptjs": "^2.4.3",
    "graphql": "^16.10.0",
    "jsonwebtoken": "^9.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "prisma": "6.19.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/bcryptjs": "^2.4.6"
  }
}
